;; Corp keys tuned by ES in R2 (research/rounds/R2/es-corp.jsonl; +7.4 points vs S1, p=0.007).
;; Every tunable constant for the knowledge-driven agents (S1 rules, S3 evaluator features).
{:ap-value 7.0              ; credits-equivalent of one agenda point for run decisions
 :click-value 1.0           ; credits-equivalent of one click
 :w-damage 2.0              ; credits-equivalent per net damage taken
 :min-run-utility 0.5       ; run only if expected utility exceeds this
 :runner-econ-floor 4       ; below this, prefer economy over running
 :corp-econ-floor 5         ; Corp prefers economy below this many credits
 :corp-rez-reserve 4        ; credits kept when rezzing ice on an empty remote / Archives
 :corp-safety-extra 1.4       ; assume the Runner has this many more credits next turn
 :corp-ice-per-central 0    ; target ice count on HQ / R&D
 :corp-ice-scoring-remote 3 ; target ice count on the scoring remote
 :bluff-advance-p 0.2       ; chance to advance an installed ambush as a bluff when idle
 :max-remotes 3
 :runner-draw-below 3       ; Runner draws when its hand is below this
 :runner-econ-cap 10        ; Runner plays economy events below this many credits
 :corp-econ-cap 15          ; Corp plays economy operations below this many credits
 :corp-ice-reserve 2        ; credits the Corp keeps after installing extra ice
 :potential-breakers false  ; server safety expects breakers from the Runner's hand (R4)
 :perceived-safety false    ; agenda safety judged on the Runner's view of hidden cards (R4)
 ;; S3/S2 evaluator feature weights (multipliers on the named features in knowledge/evaluator.clj)
 ;; signs and rough scale from a logistic fit of S1 self-play outcomes (research/LOG.md, R1);
 ;; :ice kept positive because its fitted negative weight is confounded by S1 over-icing when stuck
 :eval {:agenda-points 2.5
        :agendas-in-hq 1.0
        :rig -1.5
        :hands 1.0
        :corp-assets 0.5
        :runner-damage-exposure 2.0
        ;; R4 candidates, off by default
        :central-threat 0.0
        :hq-agenda-cost 0.0
        :scorable-agendas 0.0
        :kill-threat 0.0
        :asset-econ 0.0}}
