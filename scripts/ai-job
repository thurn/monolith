#!/usr/bin/env bash
# Runs a Clojure expression in a fresh ai/ JVM, detached (survives the calling shell). The JVM runs in
# its own systemd scope, so if the OOM killer hits it, only this job dies (not tmux/Claude/other jobs).
# Heap: AI_HEAP (default 8g). Keep the sum of live JVM heaps <= 24g on the 28 GB WSL VM.
# Usage: scripts/ai-job <logfile> '<clojure expr>'
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
cd "$ROOT/ai"
nohup systemd-run --user --scope --quiet --unit="ai-job-$(date +%s)-$$" ../scripts/lein trampoline run -m clojure.main -e "(do $2 (shutdown-agents) (System/exit 0))" > "$LOG" 2>&1 &
echo $!
