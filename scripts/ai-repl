#!/usr/bin/env bash
# Starts a long-lived JVM for the ai/ project with a socket REPL on port 5555 (for development).
# Own systemd scope (see ai-job); heap AI_HEAP (default 8g).
set -euo pipefail
cd "$(dirname "$0")/../ai"
export JVM_OPTS="-Dclojure.server.repl={:port,${AI_REPL_PORT:-5555},:accept,clojure.core.server/repl}"
exec systemd-run --user --scope --quiet --unit="ai-repl-$(date +%s)" ../scripts/lein trampoline run -m clojure.main -e "(do (println :repl-ready) @(promise))"
